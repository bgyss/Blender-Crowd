{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-crowd.local/schemas/override-layer-v2.schema.json",
  "title": "Blender Crowd Sparse Override Layer v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "layer_id", "author", "created_at", "priority", "enabled", "target_agent_id", "edits", "local_resimulation"],
  "properties": {
    "schema_version": { "const": 2 },
    "layer_id": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "priority": { "type": "integer" },
    "enabled": { "type": "boolean" },
    "target_agent_id": { "type": "integer", "minimum": 0 },
    "edits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/edit" } },
    "local_resimulation": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/local_resimulation" }] }
  },
  "$defs": {
    "range": { "type": "object", "required": ["tick_start", "tick_end"], "properties": { "tick_start": { "type": "integer", "minimum": 0 }, "tick_end": { "type": "integer", "minimum": 0 } } },
    "edit": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "tick_start", "tick_end", "visible"], "properties": { "type": { "const": "visibility" }, "tick_start": { "type": "integer", "minimum": 0 }, "tick_end": { "type": "integer", "minimum": 0 }, "visible": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "tick_start", "tick_end", "offset_ticks"], "properties": { "type": { "const": "timing" }, "tick_start": { "type": "integer", "minimum": 0 }, "tick_end": { "type": "integer", "minimum": 0 }, "offset_ticks": { "type": "integer" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "tick_start", "tick_end", "multiplier_millionths"], "properties": { "type": { "const": "speed" }, "tick_start": { "type": "integer", "minimum": 0 }, "tick_end": { "type": "integer", "minimum": 0 }, "multiplier_millionths": { "type": "integer", "minimum": 1 } } },
        { "type": "object", "required": ["type", "tick_start", "tick_end"], "properties": { "type": { "enum": ["transform", "appearance", "animation", "goal", "hero"] }, "tick_start": { "type": "integer", "minimum": 0 }, "tick_end": { "type": "integer", "minimum": 0 } } }
      ]
    },
    "local_resimulation": { "type": "object", "additionalProperties": false, "required": ["affected_agent_ids", "tick_start", "tick_end", "source_base_hash"], "properties": { "affected_agent_ids": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } }, "tick_start": { "type": "integer", "minimum": 0 }, "tick_end": { "type": "integer", "minimum": 0 }, "source_base_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" } } }
  }
}
