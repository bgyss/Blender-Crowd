{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-crowd.local/schemas/project-ir-v2.schema.json",
  "title": "Blender Crowd Authorable Project IR v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base", "behavior_graphs", "population_behaviors", "semantics", "groups", "assets"],
  "properties": {
    "schema_version": { "const": 2 },
    "base": { "$ref": "project-ir-v1.schema.json" },
    "behavior_graphs": { "type": "array", "minItems": 1, "items": { "$ref": "behavior-graph-v1.schema.json" } },
    "population_behaviors": { "type": "array", "items": { "$ref": "#/$defs/population_behavior" } },
    "semantics": { "$ref": "#/$defs/semantics" },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
    "assets": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "point": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "population_behavior": { "type": "object", "additionalProperties": false, "required": ["population_id", "graph_id"], "properties": { "population_id": { "$ref": "#/$defs/id" }, "graph_id": { "$ref": "#/$defs/id" } } },
    "semantics": { "type": "object", "additionalProperties": false, "required": ["queues", "lanes", "cost_regions"], "properties": { "queues": { "type": "array", "items": { "$ref": "#/$defs/queue" } }, "lanes": { "type": "array", "items": { "$ref": "#/$defs/lane" } }, "cost_regions": { "type": "array", "items": { "$ref": "#/$defs/cost_region" } } } },
    "queue": { "type": "object", "additionalProperties": false, "required": ["id", "portal_id", "slots", "admission_capacity"], "properties": { "id": { "$ref": "#/$defs/id" }, "portal_id": { "$ref": "#/$defs/id" }, "slots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/point" } }, "admission_capacity": { "type": "integer", "minimum": 1 } } },
    "lane": { "type": "object", "additionalProperties": false, "required": ["id", "points", "strength_millionths"], "properties": { "id": { "$ref": "#/$defs/id" }, "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/point" } }, "strength_millionths": { "type": "integer", "minimum": 0, "maximum": 1000000 } } },
    "cost_region": { "type": "object", "additionalProperties": false, "required": ["id", "walkable_id", "bounds", "kind", "weight_millionths"], "properties": { "id": { "$ref": "#/$defs/id" }, "walkable_id": { "$ref": "#/$defs/id" }, "bounds": { "type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": { "min": { "$ref": "#/$defs/point" }, "max": { "$ref": "#/$defs/point" } } }, "kind": { "enum": ["interest", "danger", "preferred", "forbidden"] }, "weight_millionths": { "type": "integer", "minimum": 0, "maximum": 1000000 } } },
    "group": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "member_agent_ids", "leader_agent_id", "shared_destination_id", "max_separation_millimeters"], "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["couple", "family", "leader_follower"] }, "member_agent_ids": { "type": "array", "minItems": 2, "items": { "type": "integer", "minimum": 0 } }, "leader_agent_id": { "type": ["integer", "null"], "minimum": 0 }, "shared_destination_id": { "$ref": "#/$defs/id" }, "max_separation_millimeters": { "type": "integer", "minimum": 1 } } }
  }
}
