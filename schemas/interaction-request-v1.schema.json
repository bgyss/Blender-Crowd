{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-crowd.local/schemas/interaction-request-v1.schema.json",
  "title": "Blender Crowd Interaction Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "group_id", "participants", "tick_start", "tick_end", "seed", "mode", "action", "outcome", "root_constraints", "contact_constraints", "provenance", "budgets"],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "group_id": { "type": "string", "minLength": 1 },
    "participants": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/participant" } },
    "tick_start": { "type": "integer", "minimum": 0 },
    "tick_end": { "type": "integer", "minimum": 0 },
    "seed": { "type": "integer", "minimum": 0 },
    "mode": { "enum": ["strict", "exploratory"] },
    "action": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "minLength": 1 },
    "root_constraints": { "type": "array", "items": { "$ref": "#/$defs/root_constraint" } },
    "contact_constraints": { "type": "array", "items": { "$ref": "#/$defs/contact_constraint" } },
    "provenance": { "$ref": "#/$defs/provenance" },
    "budgets": { "$ref": "#/$defs/budgets" }
  },
  "$defs": {
    "participant": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_id", "role", "retarget_profile_id"],
      "properties": {
        "agent_id": { "type": "integer", "minimum": 0 },
        "role": { "type": "string", "minLength": 1 },
        "retarget_profile_id": { "type": "string", "minLength": 1 }
      }
    },
    "root_constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_id", "samples"],
      "properties": {
        "agent_id": { "type": "integer", "minimum": 0 },
        "samples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/root_sample" } }
      }
    },
    "root_sample": {
      "type": "object", "additionalProperties": false,
      "required": ["tick", "position", "yaw"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "position": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 3, "maxItems": 3 },
        "yaw": { "type": "number" }
      }
    },
    "contact_constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["contact_id", "owner_agent_id", "other_agent_id", "label", "tick_start", "tick_end", "required"],
      "properties": {
        "contact_id": { "type": "string", "minLength": 1 },
        "owner_agent_id": { "type": "integer", "minimum": 0 },
        "other_agent_id": { "type": "integer", "minimum": 0 },
        "label": { "enum": ["none", "touch", "support", "impact", "grip", "forbidden"] },
        "tick_start": { "type": "integer", "minimum": 0 },
        "tick_end": { "type": "integer", "minimum": 0 },
        "required": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["base_cache_hash", "graph_hash", "worker_protocol"],
      "properties": {
        "base_cache_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "graph_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "worker_protocol": { "type": "string", "minLength": 1 }
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["max_latency_ms", "max_memory_bytes", "max_output_bytes"],
      "properties": {
        "max_latency_ms": { "type": "integer", "minimum": 1 },
        "max_memory_bytes": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
