{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-crowd.local/schemas/physics-transition-v1.schema.json",
  "title": "Blender Crowd Physics Transition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transition_id", "agent_ids", "tick_start", "tick_end", "solver", "cache_hash", "recovery", "failure_policy"],
  "properties": {
    "schema_version": { "const": 1 },
    "transition_id": { "type": "string", "minLength": 1 },
    "agent_ids": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
    "tick_start": { "type": "integer", "minimum": 0 },
    "tick_end": { "type": "integer", "minimum": 0 },
    "solver": { "type": "string", "minLength": 1 },
    "cache_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "recovery": { "type": "string", "minLength": 1 },
    "failure_policy": { "enum": ["fallback", "reject", "hold"] }
  }
}
