{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-crowd.local/schemas/contact-v1.schema.json",
  "title": "Blender Crowd Contact Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contact_id", "owner_agent_id", "other_agent_id", "label", "tick_start", "tick_end", "required"],
  "properties": {
    "schema_version": { "const": 1 },
    "contact_id": { "type": "string", "minLength": 1 },
    "owner_agent_id": { "type": "integer", "minimum": 0 },
    "other_agent_id": { "type": "integer", "minimum": 0 },
    "label": { "enum": ["none", "touch", "support", "impact", "grip", "forbidden"] },
    "tick_start": { "type": "integer", "minimum": 0 },
    "tick_end": { "type": "integer", "minimum": 0 },
    "required": { "type": "boolean" }
  }
}
