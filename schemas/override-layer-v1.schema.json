{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-crowd.invalid/schemas/override-layer-v1.schema.json",
  "title": "Blender Crowd Override Layer v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "layer_id",
    "author",
    "created_at",
    "priority",
    "enabled",
    "target_agent_id",
    "tick_start",
    "tick_end",
    "operation",
    "samples"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "layer_id": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "priority": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
    "enabled": { "type": "boolean" },
    "target_agent_id": { "type": "integer", "minimum": 0 },
    "tick_start": { "type": "integer", "minimum": 0 },
    "tick_end": { "type": "integer", "minimum": 0 },
    "operation": { "enum": ["additive", "absolute"] },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tick", "translation"],
        "properties": {
          "tick": { "type": "integer", "minimum": 0 },
          "translation": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" }
          }
        }
      }
    }
  }
}
